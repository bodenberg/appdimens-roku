function AppDimens__T_sdp(v as float) as float
    t = m.t[0]
    if t = invalid then t = m.row(0)
    return v * t[0]
end function

function AppDimens__T_sdpa(v as float) as float
    t = m.t[0]
    if t = invalid then t = m.row(0)
    return v * t[1]
end function

function AppDimens__T_sdpi(v as float) as float
    t = m.t[0]
    if t = invalid then t = m.row(0)
    return v * t[2]
end function

function AppDimens__T_sdpia(v as float) as float
    t = m.t[0]
    if t = invalid then t = m.row(0)
    return v * t[3]
end function

function AppDimens__T_ssp(v as float) as float
    t = m.t[0]
    if t = invalid then t = m.row(0)
    return v * t[0] * m.fontScale
end function

function AppDimens__T_sspa(v as float) as float
    t = m.t[0]
    if t = invalid then t = m.row(0)
    return v * t[1] * m.fontScale
end function

function AppDimens__T_sspi(v as float) as float
    t = m.t[0]
    if t = invalid then t = m.row(0)
    return v * t[2] * m.fontScale
end function

